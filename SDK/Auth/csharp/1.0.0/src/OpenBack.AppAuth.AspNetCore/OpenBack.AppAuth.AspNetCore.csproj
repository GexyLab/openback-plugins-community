<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenBack.AppAuth.AspNetCore</RootNamespace>
    <AssemblyName>OpenBack.AppAuth.AspNetCore</AssemblyName>
    <PackageId>openback-app-auth-csharp-aspnetcore</PackageId>
    <Title>OpenBack App Auth for ASP.NET Core</Title>
    <Description>ASP.NET Core authentication for the access tokens of an OpenBack user pool (App authenticator): services.AddOpenBackAppAuth(...) verifies Bearer tokens locally (ES256, pool JWKS), builds the ClaimsPrincipal (sub, email, roles, permissions, org) and adds authorization policies (RequireAppRole, RequireAppPermission, verified email, guests). Sources: SDK/Auth/csharp/1.0.0.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBack.AppAuth\OpenBack.AppAuth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
