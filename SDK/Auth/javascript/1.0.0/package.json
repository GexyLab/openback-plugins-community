    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": ["src", "dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check-dist": "node scripts/build.mjs --check",
    "test": "node --test"
  }
}
