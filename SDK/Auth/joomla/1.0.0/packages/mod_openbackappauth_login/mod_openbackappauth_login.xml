<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>mod_openbackappauth_login</name>
    <author>GexyLab</author>
    <creationDate>2026-10</creationDate>
    <copyright>(C) 2026 GexyLab and the OpenBack contributors</copyright>
    <license>GPL-2.0-or-later</license>
    <authorUrl>https://github.com/GexyLab/openback-plugins-community</authorUrl>
    <version>1.0.0</version>
    <description>MOD_OPENBACKAPPAUTH_LOGIN_XML_DESCRIPTION</description>
    <namespace path="src">GexyLab\Module\OpenBackAppAuthLogin</namespace>
    <files>
        <folder module="mod_openbackappauth_login">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>
    <languages folder="language">
        <language tag="en-GB">en-GB/mod_openbackappauth_login.ini</language>
        <language tag="en-GB">en-GB/mod_openbackappauth_login.sys.ini</language>
        <language tag="it-IT">it-IT/mod_openbackappauth_login.ini</language>
        <language tag="it-IT">it-IT/mod_openbackappauth_login.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="label" type="text" label="MOD_OPENBACKAPPAUTH_LOGIN_LABEL_LABEL" description="MOD_OPENBACKAPPAUTH_LOGIN_LABEL_DESC" filter="string" />
                <field name="return_url" type="url" label="MOD_OPENBACKAPPAUTH_LOGIN_RETURN_LABEL" description="MOD_OPENBACKAPPAUTH_LOGIN_RETURN_DESC" filter="url" />
                <field name="show_logout" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="MOD_OPENBACKAPPAUTH_LOGIN_SHOW_LOGOUT_LABEL" filter="integer">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="show_link" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="MOD_OPENBACKAPPAUTH_LOGIN_SHOW_LINK_LABEL" description="MOD_OPENBACKAPPAUTH_LOGIN_SHOW_LINK_DESC" filter="integer">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
                <field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout" />
                <field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier" />
                <field name="cache" type="list" label="COM_MODULES_FIELD_CACHING_LABEL" default="0" filter="integer" validate="options">
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
