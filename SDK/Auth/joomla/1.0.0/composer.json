{
    "name": "openback/openback-app-auth-joomla",
    "description": "Joomla 4/5 package pkg_openbackappauth: sign in with an OpenBack user pool (development manifest: tests only; the extensions need no Composer at runtime).",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/GexyLab/openback-plugins-community/tree/main/SDK/Auth/joomla/1.0.0",
    "keywords": ["openback", "auth", "oidc", "authentication", "joomla"],
    "authors": [{"name": "GexyLab"}],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {"OpenBackAppAuthJoomla\\": "packages/lib_openbackappauth/src/"}
    },
    "scripts": {
        "test": "phpunit",
        "build": "@php build.php"
    }
}
