{
    "name": "openback/openback-app-auth-php",
    "description": "PHP SDK for OpenBack's App authenticator (user pools): JSON API client, OIDC web client, local ES256 token verification and PSR-15 middleware.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": ["openback", "auth", "oidc", "authentication", "jwt", "psr-15", "psr-18"],
    "homepage": "https://github.com/GexyLab/openback-plugins-community/tree/main/SDK/Auth/php/1.0.0",
    "authors": [
        {"name": "GexyLab", "homepage": "https://github.com/GexyLab"}
    ],
    "support": {
        "source": "https://github.com/GexyLab/openback-plugins-community/tree/main/SDK/Auth/php/1.0.0",
        "issues": "https://github.com/GexyLab/openback-plugins-community/issues"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "psr/simple-cache": "^3.0",
        "psr/http-server-middleware": "^1.0",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "ext-curl": "Built-in HTTP transport used when no PSR-18 client is given",
        "ext-apcu": "Shared in-process JWKS cache when no PSR-16 cache is given",
        "psr/simple-cache": "Pass any PSR-16 cache to TokenVerifier to share the JWKS cache",
        "psr/http-server-middleware": "Needed by the PSR-15 middleware OpenBack\\AppAuth\\Middleware\\RequireAppUser",
        "nyholm/psr7": "A PSR-7/PSR-17 implementation for the PSR-15 middleware and the PSR-18 transport"
    },
    "autoload": {
        "psr-4": {"OpenBack\\AppAuth\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"OpenBack\\AppAuth\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
